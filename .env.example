# Copy to .env and fill in.

# OpenSky Network OAuth2 client credentials (live traffic).
# Register a free client at: https://opensky-network.org/my-opensky/api-tokens
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Override if your hackathon bundle isn't in the default location.
